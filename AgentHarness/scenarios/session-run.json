{
  "title": "A run timed against a route shows on the HUD and in the Splits tab, beside the best run",
  "start": "game",
  "settings": {"Session Compare Clock": "0"},
  "steps": [
    {"session": "BHTests/fixtures/session-race.jsonl"},
    {"do": ["move:700,450"]},

    {"check": "in a run the HUD lists the route's splits, the first reached at its time",
     "drawn": {"text": "9:30", "font": 6, "color": 0, "inside": [472, 0, 400, 110]}},
    {"check": "ahead of the best run, and the fastest that stretch has been done, in gold",
     "drawn": {"text": "-30.0", "font": 6, "color": 4, "inside": [472, 0, 400, 110]}},
    {"check": "the second behind, in red",
     "drawn": {"text": "+30.0", "font": 6, "color": 1, "inside": [472, 0, 400, 110]}},
    {"check": "the split the run is on written as a figure is",
     "drawn": {"text": "Mephisto", "font": 6, "color": 0, "inside": [472, 0, 400, 110]}},
    {"check": "with the time to beat for it",
     "drawn": {"text": "40:00", "font": 6, "color": 5, "inside": [472, 0, 400, 110]}},
    {"check": "the run's clock under the splits",
     "drawn": {"text": "28:00", "font": 6, "color": 0, "inside": [472, 0, 400, 110]}},
    {"check": "beside the best run's time",
     "drawn": {"text": "1:15:00", "font": 6, "color": 5, "inside": [472, 0, 400, 110]}},
    {"shot": "hud-splits", "crop": [472, 0, 400, 120]},

    {"do": ["key:enter", "text:.hud full", "key:enter", "move:700,450"]},
    {"check": "the full view puts the session under the splits",
     "drawn": {"text": "Session XP", "font": 6, "inside": [472, 0, 400, 180]}},
    {"check": "and what has died",
     "drawn": {"text": "Kills", "font": 6, "inside": [472, 0, 400, 180]}},
    {"check": "with the splits still over them",
     "drawn": {"text": "-30.0", "font": 6, "color": 4, "inside": [472, 0, 400, 180]}},
    {"shot": "hud-full", "crop": [472, 0, 400, 190]},

    {"do": ["key:enter", "text:.hud line", "key:enter", "move:700,450"]},
    {"check": "the line view names the split the run is on",
     "drawn": {"text": "Mephisto", "font": 6, "inside": [472, 0, 400, 22]}},
    {"check": "with the run's clock",
     "drawn": {"text": "28:00", "font": 6, "inside": [472, 0, 400, 22]}},
    {"check": "and how the last split stood",
     "drawn": {"text": "+30.0", "font": 6, "color": 1, "inside": [472, 0, 400, 22]}},
    {"check": "and no list of splits",
     "drawn": {"text": "Andariel", "font": 6}, "count": 0},
    {"shot": "hud-line", "crop": [472, 0, 400, 40]},

    {"do": ["key:enter", "text:.session", "key:enter", "click:198,22", "move:700,450"]},
    {"check": "the Splits tab marks the split the run is on",
     "drawn": {"text": "> Mephisto"}},
    {"check": "gives the level each split was reached at",
     "drawn": {"text": "43"}},
    {"check": "the best the run could still come to",
     "drawn": {"text": "1:15:30"}},
    {"check": "the routes there are to run, with the one chosen marked",
     "drawn": {"text": "> Act bosses (Normal)"}},
    {"check": "and the run that was finished",
     "drawn": {"text": "Act bosses (Normal), finished"}},
    {"check": "the footer says which clock the times are on",
     "drawn": {"text": "Timed in real time"}},
    {"shot": "window-splits", "crop": [0, 0, 680, 420]}
  ]
