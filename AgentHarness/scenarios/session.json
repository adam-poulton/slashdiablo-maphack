{
  "title": "The session HUD and window show a recorded session, and the HUD moves only when asked",
  "start": "game",
  "steps": [
    {"session": "BHTests/fixtures/session-baal-runs.jsonl"},
    {"do": ["move:700,450"]},

    {"check": "the HUD is one line at the top of the screen, in the middle",
     "drawn": {"text": "25:51", "font": 6, "inside": [472, 0, 400, 22]}},
    {"check": "the line gives the game, how long it has run and the session's rate",
     "drawn": {"text": "+51.9K/s", "font": 6, "inside": [472, 0, 400, 22]}},
    {"check": "the line says nothing of the compact view's",
     "drawn": {"text": "Session XP"}, "count": 0},

    {"do": ["press:600,12", "move:900,300", "release:900,300", "wheel:600,12,-1", "move:700,450"]},
    {"check": "a drag and a turn of the wheel on the HUD leave it where it was, as it was",
     "drawn": {"text": "25:51", "font": 6, "inside": [472, 0, 400, 22]}},
    {"check": "and still one line",
     "drawn": {"text": "Session XP"}, "count": 0},

    {"do": ["key:enter", "text:.hud compact", "key:enter", "move:700,450"]},
    {"check": "the compact view names its figures, three rows of them",
     "drawn": {"text": "Session XP", "font": 6, "inside": [472, 0, 400, 44]}},
    {"check": "with the recent rate beside the session's",
     "drawn": {"text": "+73.5K/s", "font": 6, "inside": [472, 0, 400, 44]}},
    {"shot": "hud-compact", "crop": [472, 0, 400, 60]},

    {"do": ["key:enter", "text:.hud move", "key:enter", "move:700,450"]},
    {"check": "a HUD being placed says how to place it",
     "drawn": {"text": "Drag to move, wheel to change view, Escape when done"}},
    {"do": ["press:600,12", "move:900,200", "move:1340,300", "release:1340,300", "move:700,450"]},
    {"check": "it goes where it is dragged, and stops at the edge of the screen",
     "drawn": {"text": "Session XP", "font": 6, "inside": [1100, 270, 244, 60]}},
    {"do": ["wheel:1300,300,-1", "move:700,450"]},
    {"check": "the wheel steps it to the line view, against the same edge",
     "drawn": {"text": "+51.9K/s", "font": 6, "inside": [1244, 270, 100, 60]}},
    {"check": "which is one line again",
     "drawn": {"text": "Session XP"}, "count": 0},
    {"shot": "hud-placing", "crop": [944, 240, 400, 110]},
    {"do": ["key:esc"]},
    {"check": "Escape ends the placing",
     "drawn": {"contains": "Drag to move"}, "count": 0},
    {"check": "without opening the game's menu",
     "state": {"game.panels": []}},

    {"do": ["key:i"]},
    {"check": "the inventory opens over the HUD's half of the screen",
     "state": {"game.panels": ["inventory"]}},
    {"check": "and the HUD is not drawn over it",
     "drawn": {"text": "+51.9K/s", "font": 6}, "count": 0},
    {"do": ["key:i"]},
    {"check": "the HUD is back when the inventory shuts",
     "drawn": {"text": "+51.9K/s", "font": 6, "inside": [1244, 270, 100, 60]}},

    {"do": ["key:enter", "text:.session", "key:enter", "move:700,450"]},
    {"check": "the session window opens on its overview",
     "drawn": {"text": "Sorc_One, level 81 Sorceress"}},
    {"check": "with what the session gained",
     "drawn": {"text": "79,199,440"}},
    {"check": "and how far the next level is",
     "drawn": {"contains": "to go"}},
    {"check": "what died, and what of it was more than ordinary",
     "drawn": {"text": "1,713 (40 champion, 16 unique)"}},
    {"shot": "window-overview", "crop": [0, 0, 680, 420]},

    {"do": ["click:247,22", "move:700,450"]},
    {"check": "the Games tab lists the games under their run",
     "drawn": {"text": "baal (Hell)"}},
    {"check": "with what the finished ones average",
     "drawn": {"text": "Average of 5"}},
    {"check": "and the levels a game ran between",
     "drawn": {"text": "80 - 81"}},
    {"check": "the footer counts the games",
     "drawn": {"text": "8 games, 24:34 played"}},
    {"shot": "window-games", "crop": [0, 0, 680, 420]},

    {"do": ["click:412,22", "move:700,450"]},
    {"check": "the Kills tab lists the areas fought in by their whole names",
     "drawn": {"text": "The Worldstone Keep Level 3"}},
    {"check": "with the experience earned in each",
     "drawn": {"text": "+37.18M xp"}},
    {"check": "the kinds of monster",
     "drawn": {"text": "Minion of Destruction"}},
    {"check": "and each unique monster with where it died",
     "drawn": {"text": "Lister the Tormentor"}},
    {"check": "the footer counts the kills",
     "drawn": {"text": "1,713 kills in 6 areas"}},
    {"shot": "window-kills", "crop": [0, 0, 680, 420]},

    {"do": ["click:577,22", "move:700,450"]},
    {"check": "the Drops tab lists what the item filter pinged",
     "drawn": {"text": "Harlequin Crest Shako"}},
    {"check": "with where it fell",
     "drawn": {"text": "The Worldstone Chamber"}},
    {"check": "the footer counts the drops",
     "drawn": {"text": "9 drops"}},
    {"shot": "window-drops", "crop": [0, 0, 680, 420]},

    {"do": ["click:200,43", "text:rune", "move:700,450"]},
    {"check": "a search keeps the drops that have the text",
     "drawn": {"text": "Ist Rune"}},
    {"check": "and no others",
     "drawn": {"text": "Harlequin Crest Shako"}, "count": 0},
    {"check": "the footer counts what matched",
     "drawn": {"text": "3 matching \"rune\""}},
    {"shot": "window-drops-searched", "crop": [0, 0, 680, 420]}
  ]
}
